# Copier en .env puis changer les mots de passe (pas de caractères spéciaux : ils vont dans une URL)
POSTGRES_PASSWORD=mdp-nul
S3_ACCESS_KEY=pipeline
S3_SECRET_KEY=mdp-nul-mais-plus-long

# Pour les tests lancés depuis ta machine
DATABASE_URL=postgresql://pipeline:${POSTGRES_PASSWORD}@localhost:5434/pipeline
# Attention: les tests d'intégration font DROP TABLE, ne pas pointer sur la base de la démo
# TEST_DATABASE_URL=${DATABASE_URL}